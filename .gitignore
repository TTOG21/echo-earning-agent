node_modules/

# Never commit secrets or signing material. The Actions workflow only stages known
# status files; these ignores still protect local dry-runs and accidental `git add -A`.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.wallet

# Job-local sentinel: agent.mjs writes this on an earning event; the workflow fails
# the run to email the operator. Not source of truth (status.md / history.jsonl are).
NOTIFY.txt
